APP_MODE=private
PORT=8787
LAYER_GATEWAY_URL=https://your-layer-gateway.example
LAYER_API_KEY=replace-with-server-side-key
DEMO_NAMESPACE=standup-demo-local
PRIVATE_NAMESPACE=standup-private-owner
SANDBOX_NAMESPACE=standup-sandbox-local
OWNER_TOKEN=replace-with-a-random-owner-token
# APP_VERSION is set from the exact git commit by the build/deployment.
# GRANOLA_ADAPTER_URL=https://your-server-side-adapter.example
# GRANOLA_API_KEY=server-side-adapter-token
# SANDBOX_EXPIRES_AT is mandatory only in APP_MODE=sandbox, ISO datetime.
